+// Compares a YYYY-MM-DD closing date against the LOCAL calendar date
+// (not a UTC-midnight instant), so an opportunity stays "open" for
+// its entire local closing day regardless of the visitor's timezone
+// or time of day. Returns the number of whole calendar days remaining
+// (0 = closes today, negative = already past its closing date).
+function daysUntil(dateOnlyString){
+  if(!dateOnlyString) return -1;
+  const [y,m,d]=String(dateOnlyString).split('-').map(Number);
+  if(!y||!m||!d) return -1;
+  const closing=new Date(y,m-1,d); // local midnight of the closing date
+  const today=new Date();
+  const todayLocal=new Date(today.getFullYear(),today.getMonth(),today.getDate());
+  return Math.round((closing-todayLocal)/86400000);
+}
